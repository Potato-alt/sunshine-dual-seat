# Headless Sway session for Sunshine remote gaming (run as the remote user, @OPERATOR_USER@).
# No physical output: everything lives on the virtual HEADLESS-1.

output HEADLESS-1 resolution 1920x1080@60Hz position 0,0
output * max_render_time off

# Visible bar with a 1-second ticker: the headless desktop is static
# (no cursor, static wallpaper), and Sunshine's wlgrab requests frames
# with damage — without periodic damage the first frame never arrives.
bar {
    position top
    status_command @OPERATOR_HOME@/.config/sway-sunshine/ticker.sh
}

# Input isolation: physical host devices disabled, only Sunshine's
# virtual libvirtualhid devices are enabled.
input * events disabled
input "48879:57005:Keyboard_passthrough" events enabled
input "48879:57005:Keyboard_passthrough" xkb_layout "us,ru"
input "48879:57005:Keyboard_passthrough" xkb_options "grp:alt_shift_toggle,grp:caps_toggle"
input type:keyboard xkb_layout "us,ru"
input type:keyboard xkb_options "grp:alt_shift_toggle,grp:caps_toggle"
input "48879:57005:Mouse_passthrough" events enabled
input "48879:57005:Mouse_passthrough_(absolute)" events enabled
input type:joystick events enabled

input "48879:57005:Mouse_passthrough" accel_profile flat
input "48879:57005:Mouse_passthrough" pointer_accel 0.6
input "48879:57005:Mouse_passthrough" scroll_factor 1.5
input "48879:57005:Mouse_passthrough_(absolute)" accel_profile flat
input "48879:57005:Mouse_passthrough_(absolute)" pointer_accel 0.6
input "48879:57005:Mouse_passthrough" scroll_factor 1.5

bindsym Mod4+Return exec kitty

exec sh -c "for i in 1 2 3 4 5; do pactl set-sink-volume sink-sunshine-stereo 150% 2>/dev/null && break; sleep 2; done"
bindsym Mod4+d exec wofi --show drun,run
